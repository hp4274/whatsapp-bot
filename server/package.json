{
  "name": "whatsapp-sender-server",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Express backend for WhatsApp Sender: transports, queue, rate limiting, retries, history.",
  "main": "src/index.js",
  "scripts": {
    "start": "node src/index.js",
    "dev": "node --watch --watch-path=src src/index.js",
    "test": "node --import ./test/isolate-home.js --test test/",
    "restore": "node scripts/restore.js",
    "auth:decrypt": "node scripts/auth-decrypt.js"
  },
  "engines": {
    "node": ">=22.5.0"
  },
  "dependencies": {
    "@cacheable/node-cache": "^1.7.6",
    "@whiskeysockets/baileys": "7.0.0-rc14",
    "express": "^5.1.0",
    "multer": "^2.0.0",
    "qrcode": "^1.5.4",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "puppeteer-core": "^24.38.0"
  }
}
